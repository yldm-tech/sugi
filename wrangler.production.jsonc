// Production configuration of https://sugi.moe, used only by scripts/deploy-production.sh (`wrangler deploy --config wrangler.production.jsonc`). Self-hosters use wrangler.jsonc, which has no sugi.moe specifics.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sugi",
  // The account that holds the sugi.moe zone; a Worker custom domain must live in the zone's account.
  "account_id": "e2b27aea5f599efdbe0a7016a2580d05",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "build": {
    "command": "node scripts/build-client.mjs"
  },
  // Zone routes, not Custom Domains: all three hostnames are then served under the zone's Universal SSL certificate (sugi.moe, *.sugi.moe), so a browser that reuses one HTTP/2 connection for another of them is answered by this Worker. With a Custom Domain per hostname each got its own certificate and such coalesced requests got an empty 403 from the edge. The hostnames need proxied DNS records (AAAA 100::).
  "routes": [
    { "pattern": "sugi.moe/*", "zone_name": "sugi.moe" },
    { "pattern": "files.sugi.moe/*", "zone_name": "sugi.moe" },
    { "pattern": "tmp.sugi.moe/*", "zone_name": "sugi.moe" }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "triggers": {
    "crons": ["*/10 * * * *", "5 0 * * *"]
  },
  "vars": {
    "SITE_NAME": "sugi.moe",
    "MAIN_ORIGIN": "https://sugi.moe",
    "FILES_ORIGIN": "https://files.sugi.moe",
    "TMP_ORIGIN": "https://tmp.sugi.moe",
    "OPERATOR_NAME": "YLDM Co., Ltd.",
    "CONTACT_EMAIL": "hi@sugi.moe",
    "ABUSE_EMAIL": "abuse@sugi.moe",
    "SOURCE_URL": "https://github.com/yldm-tech/sugi",
    "CSAM_SCANNING": "1",
    "EMAIL_ROUTING": "1",
    "WAF_RATE_LIMIT": "1",
    "STORAGE_LOCATION": "APAC",
    "RESEND_REGION": "ap-northeast-1",
    "MAIL_FROM": "sugi.moe <login@sugi.moe>",
    // The bucket's R2 custom domain; files are served through the zone cache so the CSAM Scanning Tool sees them.
    "CACHE_ORIGIN": "https://r2.sugi.moe",
    "ZONE_ID": "0ec67ba827776b3d9e3452483205b04c",
    "QUOTA_ANON_BYTES_PER_DAY": "1073741824",
    "QUOTA_ACCOUNT_BYTES_PER_DAY": "5368709120",
    "QUOTA_GLOBAL_BYTES_PER_DAY": "53687091200",
    "ALERT_5XX_PER_HOUR": "20",
    "ALERT_DAILY_UPLOAD_BYTES": "21474836480",
    "VIDEO_UPLOADS": "account",
    "MAINLAND_CHINA_FAQ": "1",
    "DONATE_ALIPAY_QR": "https://files.sugi.moe/asdqxrfa.webp",
    "DONATE_ALIPAY_LINK": "https://qr.alipay.com/fkx18192ol0ftc6z3e3rba7",
    "DONATE_THANKS": "",
    "FEATURE_ACCOUNTS": "1",
    "ACCOUNT_FEATURES": "email,github,google,passkey,sync,tokens",
    "FEATURE_CLI": "1",
    // "1" keeps search engines out entirely (robots.txt disallows everything, every response says noindex); for staging and private instances.
    "NOINDEX": "0"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sugi",
      "database_id": "61f7d685-83be-4cad-9a56-b6ce9887affb",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "sugi"
    },
    // Daily-ish backup of permanent files (src/backup.ts), same location hint (APAC) as the main bucket.
    {
      "binding": "BACKUP",
      "bucket_name": "sugi-backup"
    }
  ],
  "ratelimits": [
    {
      "name": "UPLOAD_LIMITER",
      "namespace_id": "48613",
      "simple": { "limit": 10, "period": 60 }
    },
    // Logged-in accounts (session or API token), counted per account: keep in sync with ACCOUNT_RATE_LIMIT in src/limits.ts.
    {
      "name": "ACCOUNT_LIMITER",
      "namespace_id": "48614",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
  // Secrets come from ~/.config/sugi/secrets.env via --secrets-file: IP_HASH_SECRET, ADMIN_TOKEN, TRUSTED_TOKEN, CF_PURGE_TOKEN, RESEND_API_KEY, GITHUB_CLIENT_ID/SECRET, GOOGLE_CLIENT_ID/SECRET. Never UPLOAD_TOKEN: it would close uploads to the public.
}
