#!/usr/bin/env bash
# Upload images to sugi and print one direct URL per line, in argument order.
#
# Usage: sugi-upload FILE...
#
# Environment:
#   SUGI_URL            service base URL (default https://sugi.moe)
#   SUGI_TRUSTED_TOKEN  maintainers' token: passes the upload gate and is exempt from rate limits
#   SUGI_UPLOAD_TOKEN   bearer token, needed while the service has its upload gate on
#   SUGI_SECRETS_FILE   where to look for TRUSTED_TOKEN when SUGI_TRUSTED_TOKEN is unset (default ~/.config/sugi/secrets.env)
#
# The trusted token wins over the upload token when both are available.
#
# Exits non-zero if any file fails; the remaining files are still attempted and errors go to stderr.

set -uo pipefail

base="${SUGI_URL:-https://sugi.moe}"
base="${base%/}"

if [ "$#" -eq 0 ]; then
  echo "usage: sugi-upload FILE..." >&2
  exit 2
fi

if ! command -v curl >/dev/null 2>&1; then
  echo "sugi-upload: curl not found" >&2
  exit 2
fi

trusted="${SUGI_TRUSTED_TOKEN:-}"
secrets_file="${SUGI_SECRETS_FILE:-$HOME/.config/sugi/secrets.env}"
if [ -z "$trusted" ] && [ -r "$secrets_file" ]; then
  trusted="$(sed -n 's/^TRUSTED_TOKEN=//p' "$secrets_file" | head -n1)"
fi
token="${trusted:-${SUGI_UPLOAD_TOKEN:-}}"

# upload FILE [extra curl args...]: prints the body followed by a line with the HTTP status.
upload() {
  local f="$1"
  shift
  # The token goes through a curl config read from stdin so it never appears in the process list. The zone's WAF rate limiting rule exempts exactly this Authorization header value, so both layers see the trusted token in the same place.
  local config=""
  if [ -n "$token" ]; then
    config="header = \"Authorization: Bearer ${token}\""
  fi
  printf '%s\n' "$config" | curl --silent --show-error \
    --connect-timeout 10 --max-time 120 \
    --config - \
    --header "Accept: text/plain" \
    --upload-file "$f" \
    --write-out $'\n%{http_code}' \
    "$@" \
    "$base/upload"
}

status=0
for file in "$@"; do
  if [ ! -f "$file" ] || [ ! -r "$file" ]; then
    echo "sugi-upload: $file: not a readable file" >&2
    status=1
    continue
  fi


  # Raw PUT avoids curl -F's special handling of ';' and ',' in file names.
  response="$(upload "$file")"
  rc=$?
  # Exit 7 is a connect failure. A resolver that only has AAAA records cached on a host without working IPv6 fails this way, so retry once over IPv4; the upload is content-addressed, so repeating it is harmless.
  if [ "$rc" -eq 7 ]; then
    response="$(upload "$file" --ipv4)"
    rc=$?
    # Exit 6 here means the system resolver has no A record cached at all (macOS can negatively cache A while keeping AAAA). Ask DNS directly and pin the address for this one request.
    if [ "$rc" -eq 6 ] && command -v dig >/dev/null 2>&1; then
      hostport="${base#*://}"
      hostport="${hostport%%/*}"
      host="${hostport%%:*}"
      port="${hostport##*:}"
      [ "$port" = "$hostport" ] && { [ "${base%%://*}" = "http" ] && port=80 || port=443; }
      # Try the configured resolver first, then a public one: some local resolvers (e.g. a VPN's) answer AAAA only. TLS still verifies the hostname, so a wrong address can only fail, not impersonate the server.
      for server in "" "@1.1.1.1"; do
        ip="$(dig +short +time=3 +tries=1 $server A "$host" 2>/dev/null | grep -E '^[0-9]+(\.[0-9]+){3}$' | head -n1)"
        [ -n "$ip" ] && break
      done
      if [ -n "$ip" ]; then
        response="$(upload "$file" --ipv4 --resolve "$host:$port:$ip")"
        rc=$?
      fi
    fi
  fi
  if [ "$rc" -ne 0 ]; then
    echo "sugi-upload: $file: curl failed (exit $rc)" >&2
    status=1
    continue
  fi

  code="${response##*$'\n'}"
  body="${response%$'\n'*}"
  body="${body%$'\n'}"
  case "$code" in
    200 | 201)
      if [[ "$body" =~ ^https?://[^[:space:]]+$ ]]; then
        printf '%s\n' "$body"
      else
        echo "sugi-upload: $file: unexpected response: $body" >&2
        status=1
      fi
      ;;
    *)
      echo "sugi-upload: $file: HTTP $code: $body" >&2
      status=1
      ;;
  esac
done

exit "$status"
