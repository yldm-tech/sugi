#!/usr/bin/env bash
# Upload images to sugi and print one direct URL per line, in argument order.
#
# Usage: sugi-upload FILE...
#
# Environment:
#   SUGI_URL            service base URL (default https://sugi.moe)
#   SUGI_TRUSTED_TOKEN  maintainers' token: passes the upload gate and is exempt from rate limits
#   SUGI_UPLOAD_TOKEN   bearer token, needed while the service has its upload gate on
#   SUGI_SECRETS_FILE   where to look for TRUSTED_TOKEN when SUGI_TRUSTED_TOKEN is unset (default ~/.config/sugi/secrets.env)
#
# The trusted token wins over the upload token when both are available.
#
# Exits non-zero if any file fails; the remaining files are still attempted and errors go to stderr.

set -uo pipefail

base="${SUGI_URL:-https://sugi.moe}"
base="${base%/}"

if [ "$#" -eq 0 ]; then
  echo "usage: sugi-upload FILE..." >&2
  exit 2
fi

if ! command -v curl >/dev/null 2>&1; then
  echo "sugi-upload: curl not found" >&2
  exit 2
fi

trusted="${SUGI_TRUSTED_TOKEN:-}"
secrets_file="${SUGI_SECRETS_FILE:-$HOME/.config/sugi/secrets.env}"
if [ -z "$trusted" ] && [ -r "$secrets_file" ]; then
  trusted="$(sed -n 's/^TRUSTED_TOKEN=//p' "$secrets_file" | head -n1)"
fi
token="${trusted:-${SUGI_UPLOAD_TOKEN:-}}"

status=0
for file in "$@"; do
  if [ ! -f "$file" ] || [ ! -r "$file" ]; then
    echo "sugi-upload: $file: not a readable file" >&2
    status=1
    continue
  fi

  # The token goes through a curl config read from stdin so it never appears in the process list.
  # The zone's WAF rate limiting rule exempts exactly this Authorization header value, so both layers see the trusted token in the same place.
  config=""
  if [ -n "$token" ]; then
    config="header = \"Authorization: Bearer ${token}\""
  fi

  # Raw PUT avoids curl -F's special handling of ';' and ',' in file names.
  response="$(printf '%s\n' "$config" | curl --silent --show-error \
    --connect-timeout 10 --max-time 120 \
    --config - \
    --header "Accept: text/plain" \
    --upload-file "$file" \
    --write-out $'\n%{http_code}' \
    "$base/upload")"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "sugi-upload: $file: curl failed (exit $rc)" >&2
    status=1
    continue
  fi

  code="${response##*$'\n'}"
  body="${response%$'\n'*}"
  body="${body%$'\n'}"
  case "$code" in
    200 | 201)
      if [[ "$body" =~ ^https?://[^[:space:]]+$ ]]; then
        printf '%s\n' "$body"
      else
        echo "sugi-upload: $file: unexpected response: $body" >&2
        status=1
      fi
      ;;
    *)
      echo "sugi-upload: $file: HTTP $code: $body" >&2
      status=1
      ;;
  esac
done

exit "$status"
