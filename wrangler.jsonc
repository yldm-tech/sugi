{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sugi",
  // Evan@yldm.tech's Account, which also holds the sugi.moe zone; a Worker custom domain must live in the zone's account.
  "account_id": "e2b27aea5f599efdbe0a7016a2580d05",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "sugi.moe",
      "custom_domain": true
    }
  ],
  "vars": {
    // Origin hostname for cache-through image serving: an R2 custom domain on the bucket, e.g. "https://r2.sugi.moe". Empty means images are read from the bucket binding directly and never enter the zone cache.
    "CACHE_ORIGIN": "",
    // sugi.moe zone, used to purge cached copies of deleted images (needs the CF_PURGE_TOKEN secret).
    "ZONE_ID": "0ec67ba827776b3d9e3452483205b04c"
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "sugi"
    }
  ],
  // The Rate Limiting binding only accepts a period of 10 or 60 seconds, so "60 per hour" is expressed as a burst-friendly 10 uploads per 60 seconds per client. Counters are per Cloudflare location and eventually consistent, so treat this as abuse damping rather than an exact quota.
  "ratelimits": [
    {
      "name": "UPLOAD_LIMITER",
      "namespace_id": "48613",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
  // Secrets (set with `wrangler secret put` or `wrangler deploy --secrets-file`, never in this file): IP_HASH_SECRET (required for uploads), ADMIN_TOKEN (enables admin endpoints), UPLOAD_TOKEN (while set, uploads need `Authorization: Bearer <token>`).
}
