// sugi: a self-hostable image and short-video host on Cloudflare Workers, R2 and D1.
//
// This is the template configuration: it deploys into any Cloudflare account as is (one-click "Deploy to Cloudflare" or `npm run deploy`). The R2 bucket and the D1 database are created on the first deploy, the schema is applied on the first request, and the site works on its *.workers.dev address with no custom domain. See README.md for every setting.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-sugi",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  // The privacy policy says the Worker keeps no request logs; keep Workers Logs off unless you change that text.
  "observability": { "enabled": false },
  "build": {
    "command": "node scripts/build-client.mjs"
  },
  // Static files (fonts, the browser bundle, the CLI, icons). The Worker runs first for every request so it can add security headers and route by hostname.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Deletes expired temporary uploads.
  "triggers": {
    "crons": ["*/10 * * * *", "5 0 * * *"]
  },
  "vars": {
    // Name shown in titles and the logo ("sugi.moe" becomes "sugi♥moe"). Empty: the hostname.
    "SITE_NAME": "",
    // Public origins. Empty MAIN_ORIGIN: whatever host the request came in on (e.g. https://my-sugi.<you>.workers.dev). Empty FILES_ORIGIN / TMP_ORIGIN: files are served from /_files and /_tmp on the main host. With your own domain, point them at dedicated hostnames such as https://files.example.org.
    "MAIN_ORIGIN": "",
    "FILES_ORIGIN": "",
    "TMP_ORIGIN": "",
    // Who runs this instance and how to reach them; shown on the terms and privacy pages, which you are responsible for.
    "OPERATOR_NAME": "",
    "CONTACT_EMAIL": "",
    "ABUSE_EMAIL": "",
    // Public source code of your deployment (e.g. https://github.com/you/sugi), linked from the footer, FAQ and developer page. MIT does not require it, but it helps your users. Empty: no link.
    "SOURCE_URL": "",
    // Set to "1" only after enabling Cloudflare's CSAM Scanning Tool on your zone; the FAQ and privacy policy then say so.
    "CSAM_SCANNING": "0",
    // Set to "1" if mail to CONTACT_EMAIL / ABUSE_EMAIL goes through Cloudflare Email Routing; the privacy policy then lists it.
    "EMAIL_ROUTING": "0",
    // Set to "1" once the zone has the WAF rate limiting rule for upload paths described in README.md; the developer page then mentions it.
    "WAF_RATE_LIMIT": "0",
    // Optional statements for the privacy policy: where the R2 bucket stores data, and the Resend region used for login emails.
    "STORAGE_LOCATION": "",
    "RESEND_REGION": "",
    // Sender of login emails (accounts only), e.g. "My site <login@example.org>".
    "MAIL_FROM": "",
    // Optional: an R2 custom domain on the bucket to serve files through your zone's cache, plus the zone id for purging (needs the CF_PURGE_TOKEN secret).
    "CACHE_ORIGIN": "",
    "ZONE_ID": "",
    // Daily upload quotas in bytes (0 = unlimited): per source without an account, per account, and for the whole site (after which only trusted and admin uploads are taken).
    "QUOTA_ANON_BYTES_PER_DAY": "1073741824",
    "QUOTA_ACCOUNT_BYTES_PER_DAY": "5368709120",
    "QUOTA_GLOBAL_BYTES_PER_DAY": "53687091200",
    // Alert emails to OPS_EMAIL (a secret, like the daily report): server errors per hour, and bytes uploaded in a day (0 = off).
    "ALERT_5XX_PER_HOUR": "20",
    "ALERT_DAILY_UPLOAD_BYTES": "0",
    // Set to "1" to add an FAQ entry on access from mainland China, which states that the site has no ICP filing there and runs on Cloudflare's global network (not its China Network). Only if that is true for your deployment.
    "MAINLAND_CHINA_FAQ": "0",
    // Who may upload videos. Cloudflare's CSAM Scanning Tool only checks images, so by default videos need a logged-in account or an API token (with accounts off: only TRUSTED_TOKEN and ADMIN_TOKEN). "anyone" lets anonymous visitors upload videos too.
    "VIDEO_UPLOADS": "account",
    // Donate page ("Feed the hamster"): shown, with a nav entry, once a payment method is set. DONATE_ALIPAY_QR is an image URL of your Alipay collection code (upload it to this site and use the files link), DONATE_ALIPAY_LINK the qr.alipay.com link behind it, DONATE_THANKS a comma-separated thank-you list (hidden when empty).
    "DONATE_ALIPAY_QR": "",
    "DONATE_ALIPAY_LINK": "",
    "DONATE_THANKS": "",
    // Features: the CLI and MCP server are on; accounts are off.
    "FEATURE_ACCOUNTS": "0",
    // With accounts on: which parts are live, comma-separated, from email, github, google, passkey, sync, tokens.
    "ACCOUNT_FEATURES": "email",
    "FEATURE_CLI": "1",
    // "1" keeps search engines out entirely (robots.txt disallows everything, every response says noindex); for staging and private instances.
    "NOINDEX": "0"
  },
  // Created on the first deploy (named after the Worker). The schema is applied by the Worker itself.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-sugi",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      // Created on the first deploy; the Deploy to Cloudflare button lets you rename it.
      "bucket_name": "my-sugi"
    }
  ],
  // Per-client upload limit: 10 per 60 seconds (the binding only supports 10- or 60-second periods). namespace_id only needs to be unique within your account.
  "ratelimits": [
    {
      "name": "UPLOAD_LIMITER",
      "namespace_id": "48613",
      "simple": { "limit": 10, "period": 60 }
    },
    // Logged-in accounts (session or API token), counted per account: keep in sync with ACCOUNT_RATE_LIMIT in src/limits.ts.
    {
      "name": "ACCOUNT_LIMITER",
      "namespace_id": "48614",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
  // Secrets (see .dev.vars.example): IP_HASH_SECRET and ADMIN_TOKEN are required. Optional: UPLOAD_TOKEN, TRUSTED_TOKEN, CF_PURGE_TOKEN, RESEND_API_KEY, GITHUB_CLIENT_ID/SECRET, GOOGLE_CLIENT_ID/SECRET.
}
