{
  "name": "sugi",
  "version": "1.0.0",
  "private": true,
  "description": "Anonymous image and short-video host on Cloudflare Workers, R2 and D1",
  "license": "MIT",
  "homepage": "https://sugi.moe",
  "repository": {
    "type": "git",
    "url": "https://github.com/yldm-tech/sugi"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "dev": "wrangler dev",
    "test": "node scripts/build-client.mjs && vitest run",
    "typecheck": "node scripts/build-client.mjs && tsc --noEmit && tsc --noEmit -p client",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome ci .",
    "check:layout": "node scripts/layout-check.mjs",
    "types": "wrangler types --strict-vars=false",
    "fonts": "scripts/subset-fonts.sh",
    "deploy": "wrangler deploy",
    "deploy:production": "scripts/deploy-production.sh"
  },
  "cloudflare": {
    "bindings": {
      "IP_HASH_SECRET": {
        "description": "Random secret (e.g. `openssl rand -hex 32`). Uploads are fingerprinted with an HMAC of the uploader IP under this key instead of storing the IP; uploads are refused until it is set."
      },
      "ADMIN_TOKEN": {
        "description": "Random token (e.g. `openssl rand -hex 32`) for the admin endpoints: deleting any file and purging everything uploaded from one source."
      },
      "DB": {
        "description": "D1 database for albums. The Worker creates its tables on the first request."
      },
      "BUCKET": {
        "description": "R2 bucket that stores the uploaded files."
      }
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@cloudflare/vitest-plugin": "^1.4.12",
    "@resvg/resvg-js": "2.6.2",
    "esbuild": "0.28.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@remix-run/multipart-parser": "1.1.0",
    "arctic": "^3.7.0",
    "qrcode-generator": "2.0.4",
    "zod": "4.6.7"
  }
}
