  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.12",
    "@resvg/resvg-js": "2.6.2",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@remix-run/multipart-parser": "1.1.0",
    "qrcode-generator": "2.0.4",
    "zod": "4.6.7"
  }
}
